{
  "name": "metahkg-redirect",
  "version": "6.14.0",
  "author": "wcyat <wcyat@wcyat.me>",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "prettier --write src",
    "test": "tsc --noEmit",
    "prepare": "husky install",
    "docker": "cd docker && docker-compose pull && docker-compose up -d",
    "docker:prebuilt": "yarn docker",
    "docker:source": "cd docker && docker-compose up -d --build",
    "docker:build": "cd docker && docker-compose build",
    "docker:logs": "cd docker && docker-compose logs",
    "docker:down": "cd docker && docker-compose down",
    "changelog": "generate-changelog && prettier --write CHANGELOG.md"
  },
  "dependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.4",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.11.5",
    "@googleapis/safebrowsing": "^8.0.0",
    "@mui/icons-material": "^5.15.18",
    "@mui/material": "^5.15.18",
    "@mui/material-nextjs": "^5.15.11",
    "dotenv": "^16.4.5",
    "hash.js": "^1.1.7",
    "ioredis": "^5.4.1",
    "is-localhost-ip": "^2.0.0",
    "mongodb": "^4.17.0",
    "next": "^14.2.3",
    "next-themes": "^0.3.0",
    "papaparse": "^5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tidy-url": "^1.16.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/papaparse": "^5.3.14",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "9.1.1",
    "eslint-config-next": "14.2.3",
    "generate-changelog": "^1.8.0",
    "husky": "^9.0.11",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "3.2.7",
    "typescript": "5.4.5"
  }
}
