{
  "name": "metahkg-redirect",
  "version": "6.9.0",
  "author": "wcyat <wcyat@wcyat.me>",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "next lint && prettier --write src",
    "test": "tsc --noEmit",
    "prepare": "husky install",
    "docker": "cd docker && docker-compose pull && docker-compose up -d",
    "docker:prebuilt": "yarn docker",
    "docker:source": "cd docker && docker-compose up -d --build",
    "docker:build": "cd docker && docker-compose build",
    "docker:logs": "cd docker && docker-compose logs",
    "docker:down": "cd docker && docker-compose down",
    "changelog": "generate-changelog && prettier --write CHANGELOG.md"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-regular-svg-icons": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@googleapis/safebrowsing": "^8.0.0",
    "@nextui-org/accordion": "^2.0.32",
    "@nextui-org/button": "^2.0.31",
    "@nextui-org/checkbox": "^2.0.29",
    "@nextui-org/react": "^2.3.6",
    "@nextui-org/system": "^2.1.2",
    "@nextui-org/theme": "^2.2.3",
    "@nextui-org/tooltip": "^2.0.33",
    "dotenv": "^16.4.5",
    "framer-motion": "^11.1.7",
    "hash.js": "^1.1.7",
    "ioredis": "^5.4.1",
    "is-localhost-ip": "^2.0.0",
    "mongodb": "^4.17.0",
    "next": "^14.2.3",
    "next-themes": "^0.3.0",
    "papaparse": "^5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tidy-url": "^1.16.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/papaparse": "^5.3.14",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "9.1.1",
    "eslint-config-next": "14.2.3",
    "generate-changelog": "^1.8.0",
    "husky": "^9.0.11",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "3.2.7",
    "typescript": "5.4.5"
  }
}
